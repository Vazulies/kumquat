{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for every Kumquat window.",
  "windows": ["wheel", "settings", "editor-*", "float-*"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "dialog:default",
    "drag:default"
  ]
}
